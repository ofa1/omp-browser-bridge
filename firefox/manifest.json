{
  "manifest_version": 2,
  "name": "OMP Browser Bridge",
  "version": "0.2.1",
  "description": "Lets the omp coding agent browse in this browser through native messaging.",
  "author": "Omair Ahmed",
  "homepage_url": "https://github.com/ofa1/omp-browser-bridge",
  "browser_specific_settings": {
    "gecko": {
      "id": "omp-firefox-bridge@omairahmed",
      "strict_min_version": "139.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "<all_urls>", "storage"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_area": "navbar",
    "default_title": "OMP Browser Bridge",
    "default_icon": "icons/toolbar-glyph-dark.svg",
    "theme_icons": [
      {
        "light": "icons/toolbar-glyph-light.svg",
        "dark": "icons/toolbar-glyph-dark.svg",
        "size": 16
      },
      {
        "light": "icons/toolbar-glyph-light.svg",
        "dark": "icons/toolbar-glyph-dark.svg",
        "size": 32
      }
    ],
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Toggle pause for OMP agent control"
    }
  }
}
