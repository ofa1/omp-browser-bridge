{
  "name": "omp-browser-bridge",
  "version": "0.2.1",
  "description": "Drive your installed Firefox from the omp coding agent via WebExtension and native messaging bridge",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofa1/omp-browser-bridge.git"
  },
  "homepage": "https://github.com/ofa1/omp-browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/ofa1/omp-browser-bridge/issues"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "firefox",
    "browser-automation",
    "webextension",
    "native-messaging",
    "ai-agent"
  ],
  "files": [
    "omp",
    "host/host.mjs",
    "scripts/install-host.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "omp": {
    "extensions": [
      "./omp/index.ts"
    ]
  },
  "scripts": {
    "install-host": "node scripts/install-host.mjs",
    "lint:addon": "web-ext lint --source-dir firefox",
    "lint:syntax": "node --check host/host.mjs scripts/install-host.mjs scripts/bump-version.mjs scripts/run-tests.mjs firefox/background.js firefox/content.js firefox/popup/popup.js",
    "lint": "npm run lint:addon && npm run lint:syntax",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "web-ext run --source-dir firefox --firefox /Applications/Firefox.app/Contents/MacOS/firefox --start-url about:blank",
    "build:addon": "web-ext build --source-dir firefox --artifacts-dir dist --overwrite-dest",
    "build": "npm run build:addon",
    "sign": "web-ext sign --source-dir firefox --artifacts-dir dist --channel unlisted",
    "bump": "node scripts/bump-version.mjs"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  }
}
